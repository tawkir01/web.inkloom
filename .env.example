# Inkloom Guardian Environment Configuration Example
# Copy this file to .env and configure your values

# Django Settings
DEBUG=True
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (Optional: defaults to SQLite for zero-setup local dev)
# If using PostgreSQL:
# DATABASE_URL=postgres://inkloom_user:password@localhost:5432/inkloom_db
# DB_NAME=inkloom_db
# DB_USER=inkloom_user
# DB_PASSWORD=password
# DB_HOST=localhost
# DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI & LLM Provider Adapter
# Supported: mock, openai, anthropic, gemini
AI_PROVIDER=mock
AI_API_KEY=your_api_key_here
AI_MODEL_NAME=gemini-1.5-pro

# OCR Configuration
OCR_ENGINE=tesseract
