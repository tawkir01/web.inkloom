# Inkloom Guardian Environment Configuration Example
# Copy this file to .env and configure your values

# Django Settings
DEBUG=True
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=127.0.0.1,localhost
# Local HTTP development values; use secure cookies and HTTPS in production.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
USE_X_FORWARDED_PROTO=False

# Database Configuration (Optional: defaults to SQLite for zero-setup local dev)
# If using PostgreSQL:
# DATABASE_URL=postgres://inkloom_user:password@localhost:5432/inkloom_db
# DB_NAME=inkloom_db
# DB_USER=inkloom_user
# DB_PASSWORD=password
# DB_HOST=localhost
# DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional AI analysis. Live requests send submitted text and approved evidence to
# the selected provider and may incur provider charges.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL_NAME=mock-model

# OCR provider settings are reserved; no OCR adapter is currently configured.
OCR_ENGINE=mock
